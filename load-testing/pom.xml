<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.example.temporal</groupId>
        <artifactId>spring-boot-temporal-integration</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>load-testing</artifactId>
    <packaging>jar</packaging>
    <name>load-testing</name>
    <description>Gatling load tests for the order-processing workflow REST API</description>

    <properties>
        <gatling.version>3.11.5</gatling.version>
        <gatling-maven-plugin.version>4.9.6</gatling-maven-plugin.version>
        <!-- Skip during normal build / install / deploy -->
        <maven.install.skip>true</maven.install.skip>
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <dependencies>
        <!-- Gatling Java DSL — no Scala required -->
        <dependency>
            <groupId>io.gatling.highcharts</groupId>
            <artifactId>gatling-charts-highcharts</artifactId>
            <version>${gatling.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
              Run load test:  mvn -pl load-testing gatling:test
              HTML report:    load-testing/target/gatling/<run-folder>/index.html
            -->
            <plugin>
                <groupId>io.gatling</groupId>
                <artifactId>gatling-maven-plugin</artifactId>
                <version>${gatling-maven-plugin.version}</version>
                <configuration>
                    <simulationClass>com.example.temporal.loadtest.OrderProcessingSimulation</simulationClass>
                    <jvmArgs>
                        <jvmArg>-DrampUsers=${rampUsers}</jvmArg>
                        <jvmArg>-DrampSecs=${rampSecs}</jvmArg>
                        <jvmArg>-DsteadyRate=${steadyRate}</jvmArg>
                        <jvmArg>-DsteadySecs=${steadySecs}</jvmArg>
                        <jvmArg>-DspikeUsers=${spikeUsers}</jvmArg>
                        <jvmArg>-DgetTimeout=${getTimeout}</jvmArg>
                    </jvmArgs>
                </configuration>
            </plugin>

            <!-- No spring-boot repackaging for this module -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Smoke: quick sanity check (~25 workflows) -->
        <profile>
            <id>smoke</id>
            <properties>
                <rampUsers>5</rampUsers>
                <rampSecs>5</rampSecs>
                <steadyRate>2</steadyRate>
                <steadySecs>5</steadySecs>
                <spikeUsers>5</spikeUsers>
                <getTimeout>30</getTimeout>
            </properties>
        </profile>

        <!-- Default: moderate parallel load (~350 workflows) -->
        <profile>
            <id>default-load</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <properties>
                <rampUsers>30</rampUsers>
                <rampSecs>15</rampSecs>
                <steadyRate>10</steadyRate>
                <steadySecs>30</steadySecs>
                <spikeUsers>20</spikeUsers>
                <getTimeout>30</getTimeout>
            </properties>
        </profile>

        <!-- Stress: heavy parallel load (~1,250 workflows) -->
        <profile>
            <id>stress</id>
            <properties>
                <rampUsers>50</rampUsers>
                <rampSecs>10</rampSecs>
                <steadyRate>20</steadyRate>
                <steadySecs>60</steadySecs>
                <spikeUsers>50</spikeUsers>
                <getTimeout>45</getTimeout>
            </properties>
        </profile>
    </profiles>
</project>

